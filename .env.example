# PERSPECTA Environment Configuration
# Optional: Provide a Groq API Key for real-time LLM structured framing decomposition.
# If omitted or empty, PERSPECTA seamlessly falls back to its robust built-in heuristic & mock PRISM engine.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=tvly-...

# Supabase Persistence & Observability Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PRISM Observability Configuration
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
